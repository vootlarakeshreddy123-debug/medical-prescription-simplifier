# =============================================================================
# Medical Prescription Simplifier - Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to create your local .env file:
#      cp .env.example .env
# 2. Open .env and insert your real API keys below.
# 3. Start the application:
#      npm run dev
#
# Deployment Note:
# In hosting environments (Render, Vercel, Netlify, Cloud Run, Railway, Heroku),
# add these variables directly in the provider's Environment Variables settings.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GOOGLE GEMINI API KEY (Required)
# -----------------------------------------------------------------------------
# Used for: Structuring prescription OCR text, medicine extraction, dosage
# scheduling, clinical safety checks, drug-drug interaction warnings,
# multilingual translations (Hindi, Telugu, Tamil, etc.), and patient chat Q&A.
#
# Get your API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Alias for Gemini API key (Supported as alternative):
GOOGLE_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 2. GOOGLE CLOUD VISION API KEY (Optional / Recommended for High-Resolution OCR)
# -----------------------------------------------------------------------------
# Used for: Dedicated OCR (DOCUMENT_TEXT_DETECTION) to extract printed and
# handwritten text from prescription photos, doctor slips, and PDF documents.
#
# If not configured, the application automatically routes extraction to
# Google Gemini Multimodal Vision, so a separate Vision key is optional.
#
# Get your API key from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_VISION_API_KEY=YOUR_GOOGLE_CLOUD_VISION_API_KEY_HERE

# Alias for Google Cloud Vision API key (Supported as alternative):
GOOGLE_VISION_API_KEY=

# -----------------------------------------------------------------------------
# 3. UNIFIED GOOGLE API KEY (Optional Fallback)
# -----------------------------------------------------------------------------
# If you have a single Google Cloud API key enabled for both Gemini and Vision,
# you can specify it here as a unified fallback:
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# 4. SERVER & APPLICATION CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# Port for the Node.js / Express backend server (Defaults to 3000)
PORT=3000

# Node runtime environment ('development' or 'production')
NODE_ENV=development

# Base URL for the application (Defaults to http://localhost:3000)
APP_URL=http://localhost:3000

# Optional Google Cloud Project ID (used for telemetry / cloud tracking)
GOOGLE_CLOUD_PROJECT_ID=
